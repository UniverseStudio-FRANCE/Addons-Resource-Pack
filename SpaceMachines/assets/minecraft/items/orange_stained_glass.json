{
    "model": {
        "type": "minecraft:select",
        "property": "minecraft:component",
        "component": "minecraft:custom_data",
        "cases": [
            {
                "when": {
                    "PublicBukkitValues": {
                        "slimefun:slimefun_item": "SPACE_COLLECTOR"
                    }
                },
                "model": {
                    "type": "model",
                    "model": "spacemachines:machines/space_collector"
                }
            },
            {
                "when": {
                    "PublicBukkitValues": {
                        "slimefun:slimefun_item": "RAINBOW_GLASS_HALLOWEEN"
                    }
                },
                "model": {
                    "type": "model",
                    "model": "slimefun:slimefun/halloween/rainbow_glass_halloween"
                }
            }
        ],
        "fallback": {
            "type": "model",
            "model": "minecraft:block/orange_stained_glass"
        }
    }
}